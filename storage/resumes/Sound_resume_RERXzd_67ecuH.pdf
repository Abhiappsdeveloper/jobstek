,""]]},"alignment":"left","bullets":["Mentored team of 3 developers to migrate a legacy system to .NET Core, reducing costs by 30% and increasing efficiency.","Engineered a custom software solution using ASP.NET, C#, and Angular, resulting in a 20% increase in customer engagement.","Managed and optimized CI/CD pipelines, which reduced deployment time by 40% while maintaining high-quality standards.","Collaborated with cross-functional teams to gather requirements and deliver scalable and high-performing applications.","Conducted over 50 code reviews, enhancing code quality and decreasing defect rate by 15% across the team.","Successfully integrated Azure cloud services, leading to a 25% faster application response time and improved user experience."],"companyLogo":"https://logo.clearbit.com/tcs.com","description":"","link":"","location":"Bengaluru, India","position":"Full Stack .Net Developer","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Tata Consultancy Services","height":248,"id":"cqpcg7t7mo","record":"ExperienceItem"},{"dateRange":{"fromMonth":2,"fromYear":2017,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":10,"toYear":2017},"table":{"cols":2,"record":"TableItem","rows":[["&lt;b&gt;Project name&lt;/b&gt;","&lt;b&gt;Description&lt;/b&gt;"],["",""]]},"alignment":"left","bullets":["Developed a client-facing web application using .NET MVC and Bootstrap, which resulted in a 35% increase in client acquisition.","Implemented TypeScript and JavaScript enhancements, which improved the application's performance by 15%.","Participated in the architectural design and development of a new enterprise solution, enhancing product scalability.","Analyzed and optimized SQL Server databases, improving query performance by 25% and decreasing database load times.","Trained and mentored 3 junior developers, providing guidance and improving team productivity by 20%."],"companyLogo":"https://logo.clearbit.com/flowturb.com","description":"","link":"","location":"Coimbatore, India","position":"Software Engineer","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Flowturb Solutions","height":216,"id":"0p4znhz4kl","record":"ExperienceItem"},{"dateRange":{"fromMonth":10,"fromYear":2016,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":1,"toYear":2017},"table":{"cols":2,"record":"TableItem","rows":[["&lt;b&gt;Project name&lt;/b&gt;","&lt;b&gt;Description&lt;/b&gt;"],["",""]]},"alignment":"left","bullets":["Assisted in the development and support of web-based applications using ASP.NET Webforms and SQL Server.","Collaborated in a team of 8 developers to deliver new system features, enhancing functionality by 30%.","Contributed to the creation of SSIS packages and SSRS reports, streamlining reporting processes for the business.","Optimized SQL queries and stored procedures, resulting in a 20% improvement in database performance."],"companyLogo":"https://logo.clearbit.com/maxval.com","description":"","link":"","location":"Coimbatore, India","position":"Software Developer Intern","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"MaxVal","height":184,"id":"ksr89cywe9","record":"ExperienceItem"}],"name":"","record":"ExperienceSection"},{"__t":"EducationSection","showCompanyLogos":false,"timelineWidth":161,"column":0,"enabled":true,"height":32,"items":[{"dateRange":{"fromMonth":6,"fromYear":2014,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":3,"toYear":2018},"alignment":"left","bullets":[""],"companyLogo":"","degree":"Bachelor of Engineering in Electronics and instrumentation","gpa":"","gpaText":"","institution":"Anna University","location":"Chennai","maxGpa":"","showBullets":false,"showDateRange":true,"showGpa":false,"showLocation":true,"height":52,"id":"gulkgvz0ab","record":"EducationItem"}],"name":"","record":"EducationSection"},{"__t":"ActivitySection","column":0,"enabled":true,"height":32,"items":[{"dateRange":{"fromMonth":null,"fromYear":null,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":null,"toYear":null},"alignment":"left","bullets":[],"description":"Developed a handoff chatbot using .NET Core and the Microsoft Bot Framework, allowing seamless transitions between users and agents for real-time conversations, improving customer support efficiency.","link":"","location":"","showBullets":false,"showDateRange":false,"showDescription":true,"showLink":false,"showLocation":false,"title":"Handoff Bot for User and Agent Conversations using .NET","height":71,"id":"wdc4bnjrpf","record":"ActivityItem"},{"dateRange":{"fromMonth":null,"fromYear":null,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":null,"toYear":null},"alignment":"left","bullets":[],"description":"Contributed to a niche e-commerce platform focusing on advanced search features in TypeScript.","link":"","location":"","showBullets":false,"showDateRange":false,"showDescription":true,"showLink":false,"showLocation":false,"title":"E-commerce Platform","height":55,"id":"rklpkl64iz","record":"ActivityItem"}],"name":"","record":"ActivitySection"},{"__t":"AchievementSection","showIcons":true,"column":1,"enabled":true,"height":32,"items":[{"alignment":"left","description":"Enhanced system performance by 40% through cloud technology optimization resulting in improved user satisfaction.","icon":"23-free-star-two","showDescription":true,"title":"System Performance Enhancement","height":85,"id":"vko368laje","record":"AchievementItem"},{"alignment":"left","description":"Reduced deployment times by 40% through meticulous CI/CD pipeline setup, boosting project delivery speed.","icon":"83-free-prize-award","showDescription":true,"title":"Streamlined Deployment","height":85,"id":"ckwgbf7syq","record":"AchievementItem"},{"alignment":"left","description":"Improved query performance by 25% through SQL Server analysis and optimization, enhancing overall system use.","icon":"21-free-star","showDescription":true,"title":"Database Optimization","height":69,"id":"hjax2bm1hv","record":"AchievementItem"}],"name":"","record":"AchievementSection"},{"__t":"PassionSection","showIcons":false,"column":0,"enabled":true,"height":32,"items":[{"alignment":"left","description":"Passionate about leveraging new technologies to drive innovation and solve complex problems in software development.","icon":"23-free-star-two","showDescription":true,"title":"Tech Innovation","height":79,"id":"6bre80l6a9","record":"PassionItem"},{"alignment":"left","description":"Engaged in contributing to open-source projects, sharing knowledge, and honing my development skills.","icon":"44-free-lightbulb","showDescription":true,"title":"Open Source Contribution","height":79,"id":"ssol3v726h","record":"PassionItem"}],"name":"","record":"PassionSection"}],"user":"679c715b896c9ccfe8f6b46e"}</pdfx:ecv-data>
